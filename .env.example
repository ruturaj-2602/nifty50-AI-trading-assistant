# Environment Variables & Secrets
# ===============================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.

# Angel One SmartAPI Credentials
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_account_pin_here
ANGEL_TOTP_KEY=your_totp_secret_key_here

# Trading Mode: 'paper' (simulated) or 'live' (real orders)
TRADING_MODE=paper

# Telegram Real-time Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: WhatsApp Alerts (Twilio or CallMeBot)
WHATSAPP_PHONE=
WHATSAPP_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
